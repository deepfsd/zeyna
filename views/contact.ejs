<%- include('partials/header') %>

<section class="min-h-screen pt-40 pb-20 relative bg-light flex flex-col justify-center overflow-hidden">
    <div class="absolute inset-0 bg-mesh opacity-50"></div>
    <div class="container mx-auto px-6 lg:px-12 relative z-10">

        <!-- Alert Banners -->
        <div class="max-w-4xl mx-auto mb-10">
            <% if (success) { %>
                <div class="p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-start gap-4 shadow-soft animate-fade-in-up">
                    <i data-lucide="check-circle-2" class="w-6 h-6 text-emerald-500 shrink-0 mt-0.5"></i>
                    <div>
                        <h4 class="font-display font-bold text-lg mb-1">Message Sent Successfully</h4>
                        <p class="text-sm">Thank you for reaching out to Nepsis Technologies. Our team will get back to you within 24 hours.</p>
                    </div>
                </div>
            <% } else if (error) { %>
                <div class="p-6 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 flex items-start gap-4 shadow-soft animate-fade-in-up">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-rose-500 shrink-0 mt-0.5"></i>
                    <div>
                        <h4 class="font-display font-bold text-lg mb-1">Something went wrong</h4>
                        <p class="text-sm">
                            <% if (error === 'captcha_missing' || error === 'captcha_failed') { %>
                                Please complete the reCAPTCHA verification to prove you are human.
                            <% } else { %>
                                An error occurred while sending your message. Please try again later or contact us directly at hello@nepsis.com.
                            <% } %>
                        </p>
                    </div>
                </div>
            <% } %>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start max-w-6xl mx-auto">

            <!-- Contact Form Area -->
            <div class="lg:col-span-7 gsap-reveal">
                <h1 class="text-5xl md:text-7xl font-display font-bold text-dark tracking-tight mb-6">Let's build the <span class="text-gradient">Future.</span></h1>
                <p class="text-xl text-slate-600 mb-12 leading-relaxed">
                    Have a project in mind or just want to chat about the possibilities? Fill out the form below and we'll be in touch.
                </p>

                <form action="/contact" method="POST" class="space-y-6 bg-white p-8 md:p-12 rounded-[2.5rem] shadow-soft border border-slate-100 relative z-20" onsubmit="return validateRecaptcha()">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label for="name" class="block text-sm font-semibold text-slate-700 ml-2">Your Name</label>
                            <input type="text" id="name" name="name" required class="w-full px-6 py-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/20 transition-all outline-none text-dark placeholder:text-slate-400" placeholder="John Doe">
                        </div>
                        <div class="space-y-2">
                            <label for="email" class="block text-sm font-semibold text-slate-700 ml-2">Email Address</label>
                            <input type="email" id="email" name="email" required class="w-full px-6 py-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/20 transition-all outline-none text-dark placeholder:text-slate-400" placeholder="john@example.com">
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="message" class="block text-sm font-semibold text-slate-700 ml-2">Project Details</label>
                        <textarea id="message" name="message" required rows="5" class="w-full px-6 py-4 rounded-2xl bg-slate-50 border border-slate-200 focus:border-brand-500 focus:ring-4 focus:ring-brand-500/20 transition-all outline-none text-dark placeholder:text-slate-400 resize-none" placeholder="Tell us about your goals, timeline, and technical requirements..."></textarea>
                    </div>

                    <!-- reCAPTCHA widget -->
                    <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
                    <p id="captcha-error" class="text-rose-500 text-sm hidden mt-2 ml-2 font-medium"><i data-lucide="info" class="w-4 h-4 inline mr-1"></i>Please check the box to verify you are human.</p>

                    <button type="submit" class="magnetic w-full py-4 rounded-2xl bg-brand-600 text-white font-semibold text-lg hover:bg-brand-700 transition-colors shadow-glow mt-8 flex items-center justify-center gap-2">
                        Send Message <i data-lucide="send" class="w-5 h-5"></i>
                    </button>
                </form>
            </div>

            <!-- Contact Information -->
            <div class="lg:col-span-5 gsap-reveal" style="transition-delay: 0.2s;">
                <div class="p-8 md:p-12 rounded-[2.5rem] bg-dark text-white border border-slate-800 shadow-soft h-full flex flex-col justify-between relative overflow-hidden">
                    <div class="absolute inset-0 bg-mesh-dark opacity-50 z-0"></div>

                    <div class="relative z-10 space-y-12">
                        <div>
                            <h3 class="text-2xl font-display font-bold mb-2">Contact Information</h3>
                            <p class="text-slate-400 leading-relaxed">We usually respond within 24 hours to schedule an initial discovery call.</p>
                        </div>

                        <div class="space-y-8">
                            <div class="flex items-start gap-5 group">
                                <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-brand-400 shrink-0 group-hover:scale-110 group-hover:bg-brand-500 group-hover:text-white transition-all">
                                    <i data-lucide="map-pin" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-white mb-1">Our Office</h4>
                                    <p class="text-slate-400 text-sm leading-relaxed">Nepsis Technologies<br>Pataudi, Gurugram<br>Haryana, India</p>
                                </div>
                            </div>

                            <div class="flex items-start gap-5 group">
                                <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-brand-400 shrink-0 group-hover:scale-110 group-hover:bg-brand-500 group-hover:text-white transition-all">
                                    <i data-lucide="mail" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-white mb-1">Email Us</h4>
                                    <a href="mailto:hello@nepsis.com" class="text-slate-400 text-sm hover:text-white transition-colors">hello@nepsis.com</a><br>
                                    <a href="mailto:careers@nepsis.com" class="text-slate-400 text-sm hover:text-white transition-colors">careers@nepsis.com</a>
                                </div>
                            </div>

                            <div class="flex items-start gap-5 group">
                                <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-brand-400 shrink-0 group-hover:scale-110 group-hover:bg-brand-500 group-hover:text-white transition-all">
                                    <i data-lucide="phone" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-white mb-1">Call Us</h4>
                                    <p class="text-slate-400 text-sm">+91 (124) XXX-XXXX</p>
                                    <p class="text-slate-500 text-xs mt-1">Mon-Fri, 9am - 6pm IST</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="relative z-10 mt-16 pt-8 border-t border-slate-800">
                        <h4 class="font-semibold text-white mb-4">Follow Our Journey</h4>
                        <div class="flex items-center gap-4">
                            <a href="#" class="w-12 h-12 rounded-full glass-dark flex items-center justify-center text-brand-400 hover:bg-brand-500 hover:text-white transition-all magnetic">
                                <i data-lucide="twitter" class="w-5 h-5"></i>
                            </a>
                            <a href="#" class="w-12 h-12 rounded-full glass-dark flex items-center justify-center text-brand-400 hover:bg-brand-500 hover:text-white transition-all magnetic">
                                <i data-lucide="linkedin" class="w-5 h-5"></i>
                            </a>
                            <a href="#" class="w-12 h-12 rounded-full glass-dark flex items-center justify-center text-brand-400 hover:bg-brand-500 hover:text-white transition-all magnetic">
                                <i data-lucide="github" class="w-5 h-5"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    function validateRecaptcha() {
        var response = grecaptcha.getResponse();
        if (response.length === 0) {
            document.getElementById('captcha-error').classList.remove('hidden');
            return false;
        }
        document.getElementById('captcha-error').classList.add('hidden');
        return true;
    }
</script>

<%- include('partials/footer') %>
