                <div class="p-8 flex-grow flex flex-col">
                    <h3 class="text-2xl font-display font-bold text-dark mb-4 group-hover:text-brand-600 transition-colors line-clamp-2">
                        <a href="#">Implementing RAG Pipelines with Vector Databases in Node.js</a>
                    </h3>
                    <p class="text-slate-600 mb-6 flex-grow line-clamp-3">Learn how to build Retrieval-Augmented Generation systems using Pinecone and OpenAI to ground language models in your proprietary data.</p>
                    <div class="flex items-center gap-4 text-sm text-slate-500 pt-6 border-t border-slate-200">
                        <span class="flex items-center gap-1.5"><i data-lucide="calendar" class="w-4 h-4"></i> Sep 28, 2023</span>
                        <span class="flex items-center gap-1.5"><i data-lucide="clock" class="w-4 h-4"></i> 12 min read</span>
                    </div>
                </div>
            </article>

            <!-- Article 3 -->
            <article class="gsap-stagger-item group rounded-[2.5rem] overflow-hidden bg-slate-50 border border-slate-100 hover:shadow-soft transition-all duration-300 flex flex-col h-full">
                <a href="#" class="block relative aspect-[16/9] overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-dark/60 to-transparent z-10"></div>
                    <div class="w-full h-full bg-slate-200 transition-transform duration-700 group-hover:scale-105 flex items-center justify-center relative">
                         <div class="absolute inset-0 bg-gradient-to-br from-purple-500 to-rose-600 opacity-80"></div>
                         <i data-lucide="rocket" class="w-16 h-16 text-white/50 relative z-20"></i>
                    </div>
                    <div class="absolute bottom-4 left-6 z-20 text-white text-sm font-semibold tracking-wide">DevOps</div>
                </a>
                <div class="p-8 flex-grow flex flex-col">
                    <h3 class="text-2xl font-display font-bold text-dark mb-4 group-hover:text-brand-600 transition-colors line-clamp-2">
