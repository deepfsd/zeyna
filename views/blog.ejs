<%- include('partials/header') %>

<section class="min-h-[50vh] pt-40 pb-20 relative bg-light flex flex-col justify-center overflow-hidden">
    <div class="absolute inset-0 bg-mesh opacity-50"></div>
    <div class="container mx-auto px-6 lg:px-12 relative z-10 gsap-reveal text-center">
        <h1 class="text-6xl md:text-8xl font-display font-bold text-dark tracking-tight mb-6"><span class="text-gradient">Insights</span> & Updates</h1>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
            Thoughts, perspectives, and technical deep-dives from our team of engineers and architects on the ever-evolving landscape of software development.
        </p>
    </div>
</section>

<section class="py-24 bg-white">
    <div class="container mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 gsap-stagger-container">

            <!-- Article 1 -->
            <article class="gsap-stagger-item group rounded-[2.5rem] overflow-hidden bg-slate-50 border border-slate-100 hover:shadow-soft transition-all duration-300 flex flex-col h-full">
                <a href="#" class="block relative aspect-[16/9] overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-dark/60 to-transparent z-10"></div>
                    <div class="w-full h-full bg-slate-200 transition-transform duration-700 group-hover:scale-105 flex items-center justify-center relative">
                         <div class="absolute inset-0 bg-gradient-to-br from-blue-500 to-indigo-600 opacity-80"></div>
                         <i data-lucide="server" class="w-16 h-16 text-white/50 relative z-20"></i>
                    </div>
                    <div class="absolute bottom-4 left-6 z-20 text-white text-sm font-semibold tracking-wide">Architecture</div>
                </a>
                <div class="p-8 flex-grow flex flex-col">
                    <h3 class="text-2xl font-display font-bold text-dark mb-4 group-hover:text-brand-600 transition-colors line-clamp-2">
                        <a href="#">The Transition to Micro-Frontends in Enterprise React Applications</a>
                    </h3>
                    <p class="text-slate-600 mb-6 flex-grow line-clamp-3">A deep dive into decomposing monolithic React frontends into independently deployable micro-applications to scale engineering teams.</p>
                    <div class="flex items-center gap-4 text-sm text-slate-500 pt-6 border-t border-slate-200">
                        <span class="flex items-center gap-1.5"><i data-lucide="calendar" class="w-4 h-4"></i> Oct 12, 2023</span>
                        <span class="flex items-center gap-1.5"><i data-lucide="clock" class="w-4 h-4"></i> 8 min read</span>
                    </div>
                </div>
            </article>

            <!-- Article 2 -->
            <article class="gsap-stagger-item group rounded-[2.5rem] overflow-hidden bg-slate-50 border border-slate-100 hover:shadow-soft transition-all duration-300 flex flex-col h-full">
