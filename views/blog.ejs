                         <i data-lucide="bot" class="w-16 h-16 text-white/50 relative z-20"></i>
                    </div>
                    <div class="absolute bottom-4 left-6 z-20 text-white text-sm font-semibold tracking-wide">Artificial Intelligence</div>
